# ============================================================
# BAJAJ.OS Portfolio — Environment Variables Template
# NEVER commit .env.local or any file with real secrets to git.
# Copy this file to .env.local for local development.
# ============================================================

# Public site URL (no trailing slash). Used for sitemap, robots.txt, and OG metadata.
SITE_URL=https://your-domain.vercel.app

# GitHub username for the GitHub Live section.
# Default value in code: bajajaarna4-bit
GITHUB_USERNAME=bajajaarna4-bit

# GitHub Personal Access Token — READ ONLY, public repos only.
# Create a fine-grained PAT with ZERO write permissions:
#   https://github.com/settings/tokens?type=beta
# Required scopes: Repository → Contents (Read), Metadata (Read)
# Without this, the site falls back to a verified public-data snapshot — still usable.
GITHUB_READ_ONLY_TOKEN=

# Resend API key — for the contact form email delivery.
# Create a free account at https://resend.com and generate an API key.
# Without this, the contact route runs in dry-run mode (logs but does not send email).
RESEND_API_KEY=

# Email address where contact form submissions should be delivered (your inbox).
CONTACT_TO_EMAIL=your.email@example.com

# "From" address shown to recipients.
# Must be a verified sender domain in your Resend account.
CONTACT_FROM_EMAIL=noreply@your-domain.com
